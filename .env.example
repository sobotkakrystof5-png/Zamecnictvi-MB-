# Resend API klíč — vygenerujte na https://resend.com/api-keys
# Nastavte jako environment variable ve Vercel (Project Settings → Environment Variables),
# nikdy nevkládejte skutečnou hodnotu do tohoto souboru ani do gitu.
RESEND_API_KEY=

# E-mail, na který mají chodit poptávky z kontaktního formuláře.
CONTACT_TO_EMAIL=josef.antos@zamecnictvimb.cz

# Odesílací adresa. Doména musí být v Resend ověřená (SPF/DKIM), jinak Resend
# odešle jen na test adresy. Než bude doména zamecnictvimb.cz ověřená,
# nechte výchozí sandbox adresu níže (funguje jen pro odeslání na e-mail
# účtu, který si Resend API klíč vytvořil).
CONTACT_FROM_EMAIL="Web Zámečnictví MB <onboarding@resend.dev>"
